<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmsAgent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/seed</item>
        <item name="colorSecondary">@color/seed</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorSurfaceContainer">@color/brand_surface_container</item>
        <item name="colorOutlineVariant">@color/brand_outline</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
    </style>

    <!-- 自定义底部导航活动指示器样式 (模仿苹果液态玻璃选中高光) -->
    <style name="CustomActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">64dp</item>
        <item name="android:height">44dp</item>
        <item name="android:color">?attr/colorSecondaryContainer</item>
    </style>
</resources>
