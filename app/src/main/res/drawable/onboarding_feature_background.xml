<?xml version="1.0" encoding="utf-8"?>
<!-- 功能条 + 左侧朱砂细条 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/brand_surface_container_high" />
            <stroke android:width="1dp" android:color="@color/brand_outline" />
        </shape>
    </item>
    <item android:gravity="left" android:width="3dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="12dp" android:bottomLeftRadius="12dp" />
            <solid android:color="@color/seed" />
        </shape>
    </item>
</layer-list>
