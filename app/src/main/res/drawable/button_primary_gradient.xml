<?xml version="1.0" encoding="utf-8"?>
<!-- Apple iOS Primary Action Button: Apple Black in Light mode / Crisp White in Dark mode -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#20FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/brand_text_primary" />
            <stroke android:width="1dp" android:color="@color/brand_outline" />
        </shape>
    </item>
</ripple>
