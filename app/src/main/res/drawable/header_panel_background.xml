<?xml version="1.0" encoding="utf-8"?>
<!-- iOS 26.6 空间晶体 Header：24dp Squircle + 柔和双重梯度 Edge Stroke -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="135"
                android:startColor="@color/header_panel_start"
                android:endColor="@color/header_panel_end"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#334155" />
        </shape>
    </item>
    <item android:gravity="start" android:width="4dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="24dp" android:bottomLeftRadius="24dp" />
            <solid android:color="@color/seed" />
        </shape>
    </item>
</layer-list>
