<?xml version="1.0" encoding="utf-8"?>
<!-- iOS 26.6 空间晶体 Header：24dp Squircle + 柔和双重梯度 Edge Stroke -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:angle="135"
        android:startColor="@color/header_panel_start"
        android:endColor="@color/header_panel_end"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/brand_outline" />
</shape>
