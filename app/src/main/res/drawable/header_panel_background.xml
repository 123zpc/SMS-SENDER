<?xml version="1.0" encoding="utf-8"?>
<!-- Header 深色卡片：深邃靛蓝与黑灰渐变 + 柔润 18dp 圆角 + 左侧灵动 Indigo 亮柱 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="135"
                android:startColor="@color/header_panel_start"
                android:endColor="@color/header_panel_end"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#1E293B" />
        </shape>
    </item>
    <item android:gravity="start" android:width="4dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="18dp" android:bottomLeftRadius="18dp" />
            <solid android:color="@color/seed" />
        </shape>
    </item>
</layer-list>
