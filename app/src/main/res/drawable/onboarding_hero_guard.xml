<?xml version="1.0" encoding="utf-8"?>
<!-- 深色仪器面板：常黑 + 发丝线 + 点阵纹理 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/header_panel_start" />
            <stroke android:width="1dp" android:color="@color/console_border" />
        </shape>
    </item>
    <item android:drawable="@drawable/dot_grid_dark" />
</layer-list>
