<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/brand_surface_container_high" />
            <stroke android:width="1dp" android:color="@color/brand_outline" />
        </shape>
    </item>
    <item android:gravity="left" android:width="4dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="20dp" android:bottomLeftRadius="20dp" />
            <solid android:color="@color/brand_emerald" />
        </shape>
    </item>
</layer-list>
