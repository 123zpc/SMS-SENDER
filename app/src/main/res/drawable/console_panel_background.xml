<?xml version="1.0" encoding="utf-8"?>
<!-- 控制台面板 + 顶部朱砂细线 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/console_toolbar" />
            <stroke android:width="1dp" android:color="@color/console_border" />
        </shape>
    </item>
    <item android:gravity="top" android:height="2dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="14dp" android:topRightRadius="14dp" />
            <solid android:color="@color/console_accent" />
        </shape>
    </item>
</layer-list>
