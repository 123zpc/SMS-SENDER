<?xml version="1.0" encoding="utf-8"?>
<!-- iOS 26.6 空间流体 悬浮 Capsule Dock：28dp 晶体 Squircle 圆角 + 双层微光亮边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="@color/navigation_surface" />
            <stroke android:width="1.5dp" android:color="@color/navigation_outline" />
        </shape>
    </item>
</layer-list>
