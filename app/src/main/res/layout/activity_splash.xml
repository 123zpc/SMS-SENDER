<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background"
    android:fitsSystemWindows="true">

    <!-- 点阵底纹 -->
    <com.smsagent.ui.DotGridView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 中央：品牌标 + 字标 + LED 点阵 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <FrameLayout
            android:id="@+id/splashLogo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/hero_logo_background">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/send_icon_description"
                android:padding="17dp"
                android:src="@drawable/ic_send_24"
                android:tint="@color/brand_on_primary" />
        </FrameLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/splashWordmark"
            style="@style/TextAppearance.Material3.TitleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:text="@string/app_name"
            android:textColor="@color/hero_text"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/splashTagline"
            style="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/splash_tagline"
            android:textColor="@color/hero_text_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/splashLedRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/splashLedOne"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/hero_status_dot" />

            <View
                android:id="@+id/splashLedTwo"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/hero_status_dot" />

            <View
                android:id="@+id/splashLedThree"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/hero_status_dot" />

            <View
                android:id="@+id/splashLedFour"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/hero_status_dot" />

            <View
                android:id="@+id/splashLedFive"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/hero_status_dot" />
        </LinearLayout>
    </LinearLayout>

    <!-- 左下：BOOT 行 + 闪烁光标 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/splashBootLabel"
            style="@style/TextAppearance.Material3.LabelSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.14"
            android:text="@string/splash_loading_label"
            android:textColor="@color/hero_text_muted"
            android:textSize="10sp" />

        <View
            android:id="@+id/splashCursor"
            android:layout_width="7dp"
            android:layout_height="12dp"
            android:layout_marginStart="6dp"
            android:background="@color/console_accent" />
    </LinearLayout>
</FrameLayout>
