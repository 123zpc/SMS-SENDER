<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background"
    android:fitsSystemWindows="true">

    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-84dp"
        android:layout_marginEnd="-68dp"
        android:background="@drawable/splash_orb" />

    <View
        android:layout_width="144dp"
        android:layout_height="144dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-54dp"
        android:layout_marginBottom="80dp"
        android:background="@drawable/splash_orb" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <FrameLayout
            android:id="@+id/splashFlightScene"
            android:layout_width="match_parent"
            android:layout_height="168dp">

            <View
                android:id="@+id/splashFlightTrail"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="26dp"
                android:background="@drawable/splash_flight_trail" />

            <View
                android:id="@+id/splashSignalOrigin"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/splash_progress_bar" />

            <LinearLayout
                android:id="@+id/splashMessageCard"
                android:layout_width="150dp"
                android:layout_height="90dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/splash_message_card"
                android:orientation="vertical"
                android:padding="16dp">

                <View
                    android:layout_width="36dp"
                    android:layout_height="7dp"
                    android:background="@drawable/splash_message_line_primary" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/splash_message_line_secondary" />

                <View
                    android:layout_width="82dp"
                    android:layout_height="5dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/splash_message_line_secondary" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/splashPlane"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/hero_logo_background">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/send_icon_description"
                    android:padding="15dp"
                    android:src="@drawable/ic_send_24"
                    android:tint="@color/hero_text" />
            </FrameLayout>
        </FrameLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/splashWordmark"
            style="@style/TextAppearance.Material3.HeadlineMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.08"
            android:text="@string/app_name"
            android:textColor="@color/hero_text"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/splashTagline"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/splash_tagline"
            android:textColor="@color/hero_text_muted" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/splash_loading_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/splash_progress_track">

            <View
                android:id="@+id/splashProgress"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:background="@drawable/splash_progress_bar" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.Material3.LabelSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/splash_loading_label"
                android:textColor="@color/hero_text"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/splash_loading"
                android:textColor="@color/hero_text_muted" />
        </LinearLayout>

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/hero_status_dot" />
    </LinearLayout>
</FrameLayout>
