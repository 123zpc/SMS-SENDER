<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_surface"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/onboardingHeader"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/icon_tile_primary">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:padding="8dp"
                android:src="@drawable/ic_send_24"
                android:tint="@color/seed" />
        </FrameLayout>

        <com.google.android.material.textview.MaterialTextView
            style="@style/TextAppearance.Material3.LabelLarge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:text="@string/app_name"
            android:textColor="@color/brand_text_primary"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/onboardingSkipButton"
            style="@style/TextAppearance.Material3.LabelLarge"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/onboarding_skip"
            android:textColor="@color/seed"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/onboardingFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboardingBackButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:minWidth="96dp"
            android:layout_height="48dp"
            android:enabled="false"
            android:text="@string/onboarding_back"
            android:textAllCaps="false"
            android:textColor="@color/seed"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_back_24"
            app:iconGravity="textStart"
            app:iconTint="@color/seed"
            app:strokeColor="@color/seed_outline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboardingNextButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/onboarding_next"
            android:textAllCaps="false"
            android:textColor="@color/brand_on_primary"
            app:backgroundTint="@color/seed"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_send_24"
            app:iconGravity="textEnd"
            app:iconTint="@color/brand_on_primary" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/onboardingContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/onboardingFooter"
        android:layout_below="@id/onboardingHeader"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/onboardingIndicatorOne"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/onboarding_indicator_active" />

                <View
                    android:id="@+id/onboardingIndicatorTwo"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/onboarding_indicator_inactive" />

                <View
                    android:id="@+id/onboardingIndicatorThree"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/onboarding_indicator_inactive" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/onboardingArtwork"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/onboarding_hero_primary">

                <View
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:background="@drawable/onboarding_orbit" />

                <View
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="40dp"
                    android:background="@drawable/hero_status_dot" />

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:background="@drawable/onboarding_icon_card">

                    <ImageView
                        android:id="@+id/onboardingArtworkIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/onboarding_artwork_description"
                        android:padding="16dp"
                        android:src="@drawable/ic_send_24"
                        android:tint="@color/seed" />
                </FrameLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/onboardingArtworkBadge"
                    style="@style/TextAppearance.Material3.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/onboarding_badge_background"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/seed_dark"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/onboardingCopyGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/onboardingStepText"
                    style="@style/TextAppearance.Material3.LabelMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.18"
                    android:textColor="@color/seed"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/onboardingEyebrow"
                    style="@style/TextAppearance.Material3.LabelLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:textColor="@color/brand_text_secondary"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/onboardingTitle"
                    style="@style/TextAppearance.Material3.HeadlineSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="serif"
                    android:textColor="@color/brand_text_primary"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/onboardingDescription"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:textColor="@color/brand_text_secondary"
                    app:lineHeight="22dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/onboarding_feature_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/icon_tile_primary">

                        <ImageView
                            android:id="@+id/onboardingFeatureIcon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/onboarding_artwork_description"
                            android:padding="8dp"
                            android:src="@drawable/ic_send_24"
                            android:tint="@color/seed" />
                    </FrameLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/onboardingFeatureText"
                        style="@style/TextAppearance.Material3.BodySmall"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textColor="@color/brand_text_primary"
                        app:lineHeight="19dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
