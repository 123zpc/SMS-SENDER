<?xml version="1.0" encoding="utf-8"?>
<!-- PULSE HUB 灵动脉冲 · 极客彩蛋浮层 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sealOverlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC0F172A"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/sealContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp">

        <!-- 灵动脉冲 Glass Badge Card -->
        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:background="@drawable/bureau_seal_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_spark_24"
                    android:tint="#818CF8" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.Material3.TitleMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:text="PULSE HUB"
                    android:textColor="#F8FAFC"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.Material3.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="NODE 01 · ACTIVE"
                    android:textColor="#34D399"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- 标识款识 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sealTitleText"
            style="@style/TextAppearance.Material3.LabelSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.18"
            android:text="@string/easter_seal_title"
            android:textColor="#E2E8F0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 随机语录 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sealMottoText"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:textColor="#94A3B8"
            android:textSize="15sp" />

        <!-- 消散提示 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sealDismissHint"
            style="@style/TextAppearance.Material3.LabelSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.14"
            android:text="TAP ANYWHERE TO CLOSE"
            android:textColor="#64748B"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
