<?xml version="1.0" encoding="utf-8"?>
<!-- 信号局印 · 彩蛋浮层：长按版本号 5 次或控制台 SEAL 召出 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sealOverlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/sealContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <!-- 朱砂方印 -->
        <FrameLayout
            android:layout_width="168dp"
            android:layout_height="168dp"
            android:background="@drawable/bureau_seal_background">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:columnCount="2"
                android:rowCount="2"
                android:useDefaultMargins="false">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.Material3.HeadlineMedium"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_gravity="center"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="信"
                    android:textColor="@color/brand_on_primary"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.Material3.HeadlineMedium"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_gravity="center"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="号"
                    android:textColor="@color/brand_on_primary"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.Material3.HeadlineMedium"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_gravity="center"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="局"
                    android:textColor="@color/brand_on_primary"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.Material3.HeadlineMedium"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_gravity="center"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="印"
                    android:textColor="@color/brand_on_primary"
                    android:textSize="40sp"
                    android:textStyle="bold" />
            </GridLayout>
        </FrameLayout>

        <!-- 印下款识 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sealTitleText"
            style="@style/TextAppearance.Material3.LabelSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.22"
            android:text="@string/easter_seal_title"
            android:textColor="#F2EDE3"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 随机格言 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sealMottoText"
            style="@style/TextAppearance.Material3.BodyLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:textColor="#FBF7EF"
            android:textSize="17sp"
            android:textStyle="italic" />

        <!-- 消散提示 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sealDismissHint"
            style="@style/TextAppearance.Material3.LabelSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.16"
            android:text="TAP TO SEAL AWAY"
            android:textColor="#807A6E"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
